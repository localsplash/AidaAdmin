# Node 22. Values can be supplied through scoped PlatformConfig settings.
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
ASSET_STORAGE_DIR=data/assets

# The only NocoDB bootstrap values. Never expose to browsers or Android.
NOCODB_BASE_URL=
NOCODB_API_TOKEN=

# Example public origin: https://aida-admin.localsplash.dev
PUBLIC_BASE_URL=
SESSION_SECRET=

# Dedicated Admin MySQL store: OAuth state, receipts, audit only.
# mysql://aida_admin_app:password@platform-mysql:3306/aida_admin_db
AIDA_ADMIN_DATABASE_URL=

# Shared Identity with central app sessions and directory APIs.
ID_BASE_URL=
# Optional public browser origin when ID_BASE_URL uses the private Docker network.
ID_PUBLIC_BASE_URL=
# Optional for secret/dual server trust; omitted for CIDR-only deployments.
ID_CLIENT_SECRET=
ID_TRUSTED_APP_CIDRS=
ID_EVENT_SOURCE_CIDRS=
ID_TRUSTED_PROXY_CIDRS=
ID_PARENT_DOMAIN=
ID_REGISTER_WEBHOOK=false

# OfficePulse private inventory/readiness API; dedicated ingress, not SIP or phone provisioning.
OFFICEPULSE_API_BASE_URL=
# Dedicated SELECT-only credential for OfficePulse's aidacalls_db.
# mysql://aidaadmin_ro:password@platform-mysql:3306/aidacalls_db
OFFICEPULSE_RUNTIME_DATABASE_URL=
