# AidaAdmin server configuration.
# Copy to .env for local development; unit tests need none of these.
# Production startup fails, naming any missing variable (names only, never values).

# Core
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# Where validated appearance assets (logos) are stored and served from
ASSET_STORAGE_DIR=data/assets

# Public origin of this AidaAdmin deployment (used for id redirect callbacks in phase 2)
PUBLIC_BASE_URL=

# Session cookie signing secret (generate a long random value)
SESSION_SECRET=

# AidaAdmin's own PostgreSQL database on the existing server (dedicated
# database and credential, separate from AidaControl's aida_runtime), e.g.
# postgresql://aida_admin_app:...@localhost:5432/aida_admin
# Holds durable sessions, single-use login states, and the identity-event
# log/checkpoint. Without it (dev only), memory-backed stores are used.
AIDA_ADMIN_DATABASE_URL=

# id identity service (see AIDA_POC_DATABASE_AND_INTERFACE_SPECIFICATION.md §2.1)
# CIDR lists are comma-separated IPv4 CIDRs (e.g. 10.0.0.0/8,192.0.2.10/32);
# production refuses to start when a list is empty or malformed.
ID_BASE_URL=
ID_TRUSTED_APP_CIDRS=
ID_EVENT_SOURCE_CIDRS=
ID_TRUSTED_PROXY_CIDRS=

# Re-register the /id/events webhook with id at startup (true/false)
ID_REGISTER_WEBHOOK=false

# NocoDB AidaConfiguration base (server-side only; the browser never sees these)
NOCODB_BASE_URL=
NOCODB_API_TOKEN=
NOCODB_BASE_ID=

# OfficePulseAidaIntegration provisioning API (private LAN)
OFFICEPULSE_PROVISIONING_BASE_URL=

# Existing HTTPS handset provisioning service endpoint that receives the
# deviceId and one-time enrollment token (plaintext goes only there)
HANDSET_PROVISIONING_URL=

# AidaControl runtime API
AIDACONTROL_BASE_URL=
AIDACONTROL_TRUSTED_SERVER_CIDRS=
