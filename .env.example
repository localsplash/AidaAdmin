# Node 22. A deployment states only how to reach the settings store. Every
# other value is a PlatformConfig row (cfg_tbl_Setting), resolved at startup as
# app=aida-admin > app=aida > app=* — see README "Setup" for the key list.
NOCODB_BASE_URL=
NOCODB_API_TOKEN=

# Docker objects this host already has (compose.yaml), when the defaults differ.
# PLATFORM_NETWORK=platform-local
# ADMIN_ASSETS_VOLUME=aida-admin-assets

# Process knobs with code defaults; state one only to change it.
# PORT=3001
# LOG_LEVEL=info
# ASSET_STORAGE_DIR=data/assets
# ID_REGISTER_WEBHOOK=false
